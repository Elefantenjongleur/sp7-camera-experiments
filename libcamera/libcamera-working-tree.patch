+
+						if (sp7AfAdaptiveStep_ <
+						    kSp7AfHillMinStep)
+							sp7AfAdaptiveStep_ =
+								kSp7AfHillMinStep;
+
+						++sp7AfHillReversals_;
+
+						const int32_t next =
+							clampPosition(
+								sp7AfBestPosition_ +
+								sp7AfDirection_ *
+									sp7AfAdaptiveStep_);
+
+						LOG(IPASoft, Info)
+							<< "SP7 CONT AF: hill reverse"
+							<< " direction="
+							<< sp7AfDirection_
+							<< " step="
+							<< sp7AfAdaptiveStep_
+							<< " next="
+							<< next
+							<< " bestPosition="
+							<< sp7AfBestPosition_;
+
+						if (next == sp7AfBestPosition_)
+							beginFine();
+						else
+							moveLens(next);
+
+						break;
+					}
+
+					/*
+					 * Still climbing: keep travelling in the same
+					 * direction with the current step size.
+					 */
+					int32_t next =
+						clampPosition(
+							sp7AfPosition_ +
+							sp7AfDirection_ *
+								sp7AfAdaptiveStep_);
+
+					if (next == sp7AfPosition_) {
+						/*
+						 * Optical range boundary behaves just like
+						 * walking downhill: reverse and halve.
+						 */
+						if (sp7AfAdaptiveStep_ <=
+									kSp7AfHillMinStep ||
+						    sp7AfHillReversals_ >=
+									kSp7AfHillMaxReversals) {
+							LOG(IPASoft, Info)
+								<< "SP7 CONT AF: hill boundary converged";
+							beginFine();
+							break;
+						}
+
+						sp7AfDirection_ =
+							-sp7AfDirection_;
+
+						sp7AfAdaptiveStep_ =
+							(sp7AfAdaptiveStep_ + 1) / 2;
+
+						if (sp7AfAdaptiveStep_ <
+						    kSp7AfHillMinStep)
+							sp7AfAdaptiveStep_ =
+								kSp7AfHillMinStep;
+
+						++sp7AfHillReversals_;
+
+						next =
+							clampPosition(
+								sp7AfBestPosition_ +
+								sp7AfDirection_ *
+									sp7AfAdaptiveStep_);
+
+						LOG(IPASoft, Info)
+							<< "SP7 CONT AF: hill boundary reverse"
+							<< " direction="
+							<< sp7AfDirection_
+							<< " step="
+							<< sp7AfAdaptiveStep_
+							<< " next="
+							<< next;
+					}
+
+					if (next == sp7AfPosition_ ||
+					    (next == sp7AfBestPosition_ &&
+					     sp7AfAdaptiveStep_ <=
+						     kSp7AfHillMinStep))
+						beginFine();
+					else
+						moveLens(next);
+
+					break;
+				}
+
+case Sp7AfStage::Fine: {
+					if (average > sp7AfBestScore_) {
+						sp7AfBestScore_ = average;
+						sp7AfBestPosition_ =
+							sp7AfPosition_;
+
+						LOG(IPASoft, Info)
+							<< "SP7 CONT AF: fine best position="
+							<< sp7AfBestPosition_
+							<< " score="
+							<< sp7AfBestScore_;
+					}
+
+					const int32_t next =
+						sp7AfPosition_ +
+						kSp7AfFineStep;
+
+					if (next > sp7AfFineMax_ ||
+					    next > kSp7AfMaxPosition)
+						lockFocus();
+					else
+						moveLens(next);
+
+					break;
+				}
+
+				case Sp7AfStage::Locked:
+					break;
+				}
+			}
+		}
+	}
 }
 
