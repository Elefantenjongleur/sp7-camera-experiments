+						<< sp7AfPosition_
+						<< " score=" << average
+						<< " bestPosition="
+						<< sp7AfBestPosition_
+						<< " bestScore="
+						<< sp7AfBestScore_
+						<< " step="
+						<< sp7AfAdaptiveStep_
+						<< " direction="
+						<< sp7AfDirection_
+						<< " reversals="
+						<< sp7AfHillReversals_
+						<< " worse="
+						<< clearlyWorse;
+
+					if (clearlyWorse) {
+						/*
+						 * We stepped past the local maximum.
+						 *
+						 * At minimum step size the useful peak has
+						 * been bracketed tightly enough. Finish with
+						 * the small three-point Fine scan.
+						 */
+						if (sp7AfAdaptiveStep_ <=
+									kSp7AfHillMinStep ||
+						    sp7AfHillReversals_ >=
+									kSp7AfHillMaxReversals) {
+							LOG(IPASoft, Info)
+								<< "SP7 CONT AF: hill converged"
+								<< " bestPosition="
+								<< sp7AfBestPosition_
+								<< " score="
+								<< sp7AfBestScore_;
+
+							beginFine();
+							break;
+						}
+
+						/*
+						 * Reverse direction and halve the distance.
+						 *
+						 * Rounded division gives:
